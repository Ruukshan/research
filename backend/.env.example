# Application Settings
PROJECT_NAME="Smart Career Pathway Recommendation System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api"

# Data Management (synthetic | real | mixed)
DATA_MODE=synthetic

# Database Configuration
# For local SQLite development: sqlite:///./research_app.db
# For PostgreSQL production/academic testing: postgresql://postgres:password@localhost:5432/career_research_db
DATABASE_URL=sqlite:///./research_app.db

# Random Seed for Reproducibility
RANDOM_SEED=42

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
